#!/bin/bash

# Usage: cat urls.txt | ./vscope -f path/to/oos.txt

while getopts ":f:" opt; do
  case ${opt} in
    f ) OOS_FILE="$OPTARG" ;;
    \? ) echo "Usage: vscope -f path/to/oos.txt" >&2
         exit 1 ;;
  esac
done

if [[ -z "$OOS_FILE" || ! -f "$OOS_FILE" ]]; then
  echo "[-] Please provide a valid out-of-scope file with -f option."
  exit 1
fi

# Convert OOS patterns:
# - Escape regex meta characters
# - Convert '*' into '.*' for wildcard matching
OOS_PATTERNS=$(sed '/^\s*$/d' "$OOS_FILE" \
  | sed 's/[.[\^$()+?{|]/\\&/g' \
  | sed 's/\*/.*/g')

# Use grep -Ev to exclude matches
grep -Ev -f <(echo "$OOS_PATTERNS")
